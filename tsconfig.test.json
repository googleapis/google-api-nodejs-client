{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "sourceMap": true,
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": [
    "test/*.ts",
    "test/**/*.ts",
    "system-test/**/*.ts",
    "src/generator/*.ts"
  ],
  "exclude": [
    "node_modules",
    "test/fixtures",
    "samples/**"
  ],
  "references": [
    {
      "path": "./tsconfig.src.json"
    }
  ]
}
